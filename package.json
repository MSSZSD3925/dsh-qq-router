  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "onebot.js": "^0.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-agent": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MSSZSD3925/dsh-qq-router.git"
  },
  "homepage": "https://github.com/MSSZSD3925/dsh-qq-router#readme",
  "bugs": {
    "url": "https://github.com/MSSZSD3925/dsh-qq-router/issues"
  }
